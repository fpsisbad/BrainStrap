  "rules": [
    {
      "set": "fps",
      "value": "60",
      "if": {
        "gte": {
          "battery": 2
        },
        "lte": {
          "latency": 0
        }
      },
      "why": "Caps FPS at 60. Frames your screen never shows still make heat and noise, so this keeps a laptop cooler and quieter."
    },
    {
      "set": "fps",
      "value": "$high",
      "if": {
        "gte": {
          "latency": 2
        }
      },
      "why": "Lets Roblox render more frames than your screen shows. In fast games that cuts input delay, even on a $refresh Hz screen."
    },
    {
      "set": "fps",
      "value": "$refresh",
      "if": {
        "gte": {
          "perf": 1,
          "refresh": 61
        }
      },
      "why": "Raise Roblox's 60 FPS limit to your monitor's $refresh Hz, so every refresh gets a new frame."
    },
    {
      "set": "fps",
      "value": "$refresh",
      "if": {
        "gte": {
          "quality": 1,
          "refresh": 61,
          "tier": 2
        }
      },
      "why": "Your PC has headroom, so FPS is unlocked to your monitor's $refresh Hz."
    },
    {
      "set": "api",
      "value": "d3d11",
      "if": {
        "lte": {
          "tier": 0
        }
      },
      "why": "Direct3D 11 is the most reliable renderer on older graphics chips."
    },
    {
      "set": "msaa",
      "value": "8",
      "if": {
        "gte": {
          "quality": 3,
          "tier": 3
        },
        "lte": {
          "perf": 0
        }
      },
      "why": "Maximum edge smoothing for screenshots and video. Your GPU can afford it."
    },
    {
      "set": "msaa",
      "value": "4",
      "if": {
        "gte": {
          "quality": 2,
          "tier": 2
        },
        "lte": {
          "perf": 1
        }
      },
      "why": "Smooths jagged edges. Your GPU has the headroom for 4x."
    },
    {
      "set": "msaa",
      "value": "2",
      "if": {
        "gte": {
          "quality": 2,
          "tier": 2
        }
      },
      "why": "A light 2x keeps edges clean without a big FPS cost."
    },
    {
      "set": "msaa",
      "value": "1",
      "if": {
        "gte": {
          "perf": 1
        },
        "lte": {
          "tier": 1
        }
      },
      "why": "Anti-aliasing is one of the most expensive effects on laptop and older GPUs. Turning it off is a big, easy FPS win and hard to notice on smaller screens."
    },
    {
      "set": "msaa",
      "value": "1",
      "if": {
        "gte": {
          "perf": 2
        },
        "lte": {
          "quality": 1
        }
      },
      "why": "Anti-aliasing costs a lot of GPU time for slightly smoother edges. Off is the fastest choice."
    },
    {
      "set": "texture",
      "value": "1",
      "if": {
        "lte": {
          "tier": 0
        }
      },
      "why": "Lower texture resolution frees video memory on older graphics chips."
    },
    {
      "set": "texture",
      "value": "3",
      "if": {
        "gte": {
          "quality": 2,
          "tier": 2
        }
      },
      "why": "Sharpest textures. Your GPU has enough video memory."
    },
    {
      "set": "frm",
      "value": "1",
      "if": {
        "lte": {
          "tier": 0,
          "quality": 1
        }
      },
      "why": "Forces the lowest graphics level. On very old hardware this is the difference between playable and not."
    },
    {
      "set": "frm",
      "value": "21",
      "if": {
        "gte": {
          "quality": 3,
          "tier": 3
        },
        "lte": {
          "perf": 1
        }
      },
      "why": "Locks graphics at the maximum level for screenshots and video."
    },
    {
      "set": "frm",
      "value": "10",
      "if": {
        "gte": {
          "perf": 1,
          "quality": 2
        }
      },
      "why": "Locks graphics at a middle level. Roblox's automatic quality keeps jumping up and down, which is a common cause of stutter, so a fixed level is smoother while still looking good."
    },
    {
      "set": "frm",
      "value": "8",
      "if": {
        "gte": {
          "perf": 2
        }
      },
      "why": "Locks graphics at a moderate level so Roblox stops switching quality on its own, a common cause of stutter and sudden FPS drops."
    },
    {
      "set": "frm",
      "value": "15",
      "if": {
        "gte": {
          "quality": 2,
          "tier": 2
        }
      },
      "why": "Locks graphics high so Roblox doesn't lower them on its own."
    },
    {
      "set": "frm",
      "value": "5",
      "if": {
        "gte": {
          "perf": 2
        },
        "lte": {
          "quality": -1
        }
      },
      "why": "Locks graphics low. Big FPS gain, and it stops quality from jumping around."
    },
    {
      "set": "grass",
      "value": "off",
      "if": {
        "gte": {
          "perf": 2
        },
        "lte": {
          "quality": 1
        }
      },
      "why": "Removes terrain grass. On grassy maps that's a quick FPS win, and most games look the same without it."
    },
    {
      "set": "grass",
      "value": "off",
      "if": {
        "lte": {
          "tier": 0
        }
      },
      "why": "Removes terrain grass, which older GPUs struggle to draw."
    },
    {
      "set": "grassmotion",
      "value": "true",
      "if": {
        "gte": {
          "perf": 1
        }
      },
      "why": "Stops grass from swaying: slightly cheaper and calmer to look at."
    },
    {
      "set": "grassmotion",
      "value": "true",
      "if": {
        "gte": {
          "battery": 2
        }
      },
      "why": "Stops grass from swaying to save a little power."
    },
    {
      "set": "lod",
      "value": "perf",
      "if": {
        "gte": {
          "perf": 2
        },
        "lte": {
          "quality": 1
        }
      },
      "why": "Swaps detailed models to simpler versions sooner, which helps on big detailed maps."
    },
    {
      "set": "lod",
      "value": "perf",
      "if": {
        "lte": {
          "tier": 0
        }
      },
      "why": "Swaps detailed models to simpler versions sooner, easing the load on older hardware."
    },
    {
      "set": "pausevoxel",
      "value": "true",
      "if": {
        "lte": {
          "tier": 0
        },
        "gte": {
          "perf": 3
        }
      },
      "why": "Freezes lighting recalculation. A big help on very weak PCs; lighting just won't react to moving objects."
    }
  ],
